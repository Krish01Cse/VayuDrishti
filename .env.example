# ─────────────────────────────────────────────────────────
# VayuDrishti — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env to git.
# ─────────────────────────────────────────────────────────

# ── AWS Credentials ───────────────────────────────────────
# Optional: leave empty when running on AWS with IAM Role (App Runner / ECS / Lambda / EC2)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=  # optional, for temporary STS / AWS SSO session credentials
AWS_REGION=ap-south-1

# ── Storage & DB Provider ─────────────────────────────────
# Options: aws (real AWS S3 & DynamoDB or LocalStack) | mock (in-memory)
STORAGE_PROVIDER=aws

# ── LocalStack (local development) ───────────────────────
# Set to "true" to route all AWS calls to LocalStack instead of real AWS.
USE_LOCALSTACK=false
LOCALSTACK_ENDPOINT=http://localhost:4566

# ── S3 ───────────────────────────────────────────────────
S3_BUCKET_NAME=vayudrishti-images

# ── DynamoDB Table Names ──────────────────────────────────
DYNAMO_REPORTS_TABLE=DustReports
DYNAMO_CASES_TABLE=IncidentCases
DYNAMO_DECISIONS_TABLE=ReviewDecisions
DYNAMO_AUDIT_TABLE=AuditEvents

# ── AI Vision Provider ────────────────────────────────────
# Options: bedrock | openai | mock
VISION_PROVIDER=mock

# If VISION_PROVIDER=bedrock:
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# If VISION_PROVIDER=openai:
OPENAI_API_KEY=sk-...

# ── Strands Agent ─────────────────────────────────────────
STRANDS_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ── Investigation Thresholds ──────────────────────────────
NEARBY_RADIUS_METERS=500
NEARBY_TIME_WINDOW_HOURS=48

# ── Simple Auth (MVP) ─────────────────────────────────────
# Shared bearer token for reviewer endpoints.
# Replace with a strong random string before any real deployment.
REVIEWER_TOKEN=reviewer-secret-token-change-me
