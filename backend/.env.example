# ============================================================
# VayuDrishti — environment variable reference
# Copy this file to .env and fill in your values.
# ============================================================

# ── General ─────────────────────────────────────────────────
APP_NAME=VayuDrishti
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ── LocalStack (local AWS emulation) ────────────────────────
# Set to true to use LocalStack instead of real AWS.
USE_LOCALSTACK=false
LOCALSTACK_ENDPOINT=http://localhost:4566

# ── AWS credentials ─────────────────────────────────────────
# Leave AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY empty when running on AWS (IAM Role).
# For LocalStack, "test"/"test" is used automatically.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── Storage Provider ────────────────────────────────────────
# "aws" (S3 + DynamoDB) or "mock" (in-memory)
STORAGE_PROVIDER=aws

# ── S3 ──────────────────────────────────────────────────────
S3_BUCKET_NAME=vayudrishti-images
S3_SIGNED_URL_EXPIRY_SECONDS=3600

# ── DynamoDB table names ────────────────────────────────────
DYNAMODB_TABLE_DUST_REPORTS=DustReports
DYNAMODB_TABLE_INCIDENT_CASES=IncidentCases
DYNAMODB_TABLE_REVIEW_DECISIONS=ReviewDecisions
DYNAMODB_TABLE_AUDIT_EVENTS=AuditEvents

# ── Vision / AI provider ────────────────────────────────────
# Allowed values: bedrock | openai | mock
# Use "mock" while Bedrock access is pending.
VISION_PROVIDER=mock

# Bedrock (used when VISION_PROVIDER=bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=ap-south-1

# OpenAI (used when VISION_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Geo / nearby-report search ──────────────────────────────
GEO_NEARBY_RADIUS_KM=2.0
GEO_NEARBY_TIME_WINDOW_DAYS=30

# ── Weather (Open-Meteo — no key required) ──────────────────
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_MOCK_FALLBACK=false

# ── CORS (React/Vite frontend origins) ──────────────────────
# JSON array of allowed origins.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
